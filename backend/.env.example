# Copy to .env for local dev. On Render, set these as environment variables
# in the dashboard instead (never commit a real .env).

PORT=8080

# Supabase — from Project Settings > API (the SECRET service_role key, not
# the publishable key the Flutter app uses. This key bypasses RLS — treat it
# like a root password).
SUPABASE_URL=https://bvztrnekmjaulwsjymcc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the Supabase Database Webhook must send back in the
# `x-webhook-secret` header. Generate any long random string.
WEBHOOK_SHARED_SECRET=

# Firebase Cloud Messaging — a NEW service account with ONLY the
# "Firebase Cloud Messaging API Admin" (or "Firebase Messaging Admin") role
# in the existing Firebase project (dispatch-rider-2fb16-b28e7). Do NOT reuse
# the old Firestore admin-sdk key. Paste the full downloaded JSON as a
# single-line string (escape newlines in the private_key as \n, which is how
# the JSON file already stores them).
FCM_PROJECT_ID=dispatch-rider-2fb16-b28e7
FCM_SERVICE_ACCOUNT_JSON=
